# Wastram Atelier - Firebase & Cloud Database Configuration

# 1. Firebase Web App Client Configuration
# (Found in: Firebase Console > Project Settings > General > "Your apps" > Web App </> snippet)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Firebase Admin SDK Configuration (Server-Side)
# (Found in: Firebase Console > Project Settings > Service Accounts > "Generate new private key")
# You can either place `serviceAccountKey.json` in the project root, OR set:
FIREBASE_SERVICE_ACCOUNT_KEY=

# 3. Wastram Atelier Admin Security Passcode
ADMIN_PASSCODE=Wastram@2026
ADMIN_SESSION_SECRET=wastram-atelier-secure-token-2026
